# Copiar a .env (no commitear) o exportar en el shell.
#
# Opción mnemónico (recomendado en local: no pegar clave cruda)
# MNEMONIC="word1 word2 ..."
# ACCOUNT_INDEX=0
# Cuenta custom (prefijo; ver DeployHonkVerifier.s.sol y Foundry vm.deriveKey)
# ACCOUNT_DERIVATION_PATH="m/44'/60'/0'/0/"

# Opción clave cruda (hex 0x... o decimal)
# PRIVATE_KEY=0x...

# Tras desplegar HonkVerifier, para `DeployYohualliMerkleHonkRegistry.s.sol`
# HONK_VERIFIER_ADDRESS=0x...

# RPC
# RPC_URL="https://eth-rpc-testnet.polkadot.io"
