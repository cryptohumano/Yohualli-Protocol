# EN: Copy to `.env.forge.local` (git-ignored). Never use `VITE_` here: Forge/Node read `process.env` (not bundled to the browser).
# ES: Copia a `.env.forge.local` (ignorado por git). Nunca `VITE_` aquí: Forge/Node leen `process.env` (no van al bundle del navegador).
# EN: Prefer `yarn yoh:toolbox run …` or `set -a && source .env.forge.local && set +a` instead of inlining `PRIVATE_KEY=0x…` in `npm run` (avoids shell history and logs).
# ES: Mejor `yarn yoh:toolbox run …` o `set -a && source .env.forge.local && set +a` que pegar `PRIVATE_KEY=0x…` en la misma línea de `npm run` (historial y logs del shell).

# RPC
RPC_URL=https://eth-rpc-testnet.polkadot.io

# One of: 0x hex or mnemonic (mnemónica) / Una de las dos: hex 0x o mnemónica
# PRIVATE_KEY=0x…
# MNEMONIC=
# ACCOUNT_INDEX=0

# Deployments (Despliegues)
# HONK_VERIFIER_ADDRESS=0x…
# YOHUALLI_MERKLE_REGISTRY=0x…

# setMerkleRoot (scripts/forge-merkle-set-root.sh)
# MERKLE_ROOT=0x…
# MERKLE_EPOCH=0

# EVM lab roles (scripts/yohualli-derive-evm-lab-roles.mjs) — never with VITE_ prefix
# Derivar roles EVM de lab (scripts/yohualli-derive-evm-lab-roles.mjs) — nunca con prefijo VITE
# YOHUALLI_LAB_MNEMONIC=
# YOHUALLI_LAB_MNEMONIC_PASSPHRASE=

# PVM (evm/polkadot_pvm) — see that package / ver ahí
# PRIVATE_KEY=…  (64 hex)
# POLKADOT_HUB_TESTNET_URL=
# POLKADOT_HUB_CHAIN_ID=

# Relay
# PORT=8080
# RELAY_VERBOSE=0
