# Copiar a `.env.forge.local` (gitignored) — **nunca** `VITE_`: Forge / Node leen
# `process.env` y **no** se empaquetan en el navegador. Usa `yarn yoh:toolbox run …`
# o `set -a && source .env.forge.local && set +a` (bash) en lugar de pegar
# `PRIVATE_KEY=0x…` en la misma línea del `npm run` (historial del shell / logs).

# RPC
RPC_URL=https://eth-rpc-testnet.polkadot.io

# Una de las dos: hex 0x o mnemónica
# PRIVATE_KEY=0x…
# MNEMONIC=
# ACCOUNT_INDEX=0

# Despliegues
# HONK_VERIFIER_ADDRESS=0x…
# YOHUALLI_MERKLE_REGISTRY=0x…

# setMerkleRoot (scripts/forge-merkle-set-root.sh)
# MERKLE_ROOT=0x…
# MERKLE_EPOCH=0

# Derivar roles EVM de lab (scripts/yohualli-derive-evm-lab-roles.mjs) — nunca con prefijo VITE
# YOHUALLI_LAB_MNEMONIC=
# YOHUALLI_LAB_MNEMONIC_PASSPHRASE=

# PVM (evm/polkadot_pvm) — ver ahí
# PRIVATE_KEY=…  (64 hex)
# POLKADOT_HUB_TESTNET_URL=
# POLKADOT_HUB_CHAIN_ID=

# Relay
# PORT=8080
# RELAY_VERBOSE=0
