# Alias: mismo que relay/Dockerfile. Contexto = raíz del monorepo.
# docker build -f Dockerfile.relay -t yohualli-relay .
FROM node:22-alpine
WORKDIR /app
COPY relay/package.json relay/package-lock.json ./
RUN npm ci --omit=dev
COPY relay/index.mjs ./
ENV PORT=8080
EXPOSE 8080
USER node
CMD ["node", "index.mjs"]
