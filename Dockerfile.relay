# Contexto = raíz del monorepo (Railway sin "Root" en relay; o: docker build -f Dockerfile.relay -t yohualli-relay .)
# No usar si en Railway "Root" = relay (ahí: Dockerfile en relay/ con los COPY simples)
FROM node:22-alpine
WORKDIR /app
COPY relay/package.json relay/package-lock.json ./
RUN npm ci --omit=dev
COPY relay/index.mjs ./
ENV PORT=8080
EXPOSE 8080
USER node
CMD ["node", "index.mjs"]
