# Relay Yohualli: contexto = raíz del monorepo.
# Uso: docker build -f Dockerfile.relay -t yohualli-relay .
# En Railway: Dockerfile path = Dockerfile.relay (o deja "Root" vacío; no pongas /relay a menos que el Dockerfile viva allí).
FROM node:22-alpine
WORKDIR /app
COPY relay/package.json relay/package-lock.json ./
RUN npm ci --omit=dev
COPY relay/index.mjs ./
ENV PORT=8080
EXPOSE 8080
USER node
CMD ["node", "index.mjs"]
