{
  "name": "yohualli-protocol-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-aztec-bb-msgpack-scratch.mjs",
    "install:reliable": "NPM_CONFIG_USER_AGENT=${NPM_CONFIG_USER_AGENT:-npm/10.0.0} yarn install",
    "dev": "vite --host 0.0.0.0",
    "dev:https": "vite --host 0.0.0.0",
    "dev:http": "VITE_DEV_PLAIN_HTTP=1 vite --host 0.0.0.0",
    "dev:pwa": "VITE_PWA_DEV=1 vite --host 0.0.0.0",
    "relay:yohualli": "npm --prefix relay start",
    "tunnel": "bash scripts/tunnel-localhost.sh",
    "setup:https": "bash scripts/setup-https.sh",
    "setup:ssh": "bash scripts/setup-ssh-key.sh",
    "create:icons": "bash scripts/create-icons.sh",
    "build": "tsc && vite build",
    "build:gh-pages": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint .",
    "circuit:prover:yohualli1": "node scripts/gen-yohualli-one-attest-prover.mjs",
    "verifier:sync:honk": "bash scripts/sync-honk-verifier-solidity.sh",
    "circuit:public-inputs:hex": "node scripts/bb-public-inputs-hex-lines.mjs",
    "circuit:proof-hex:yohualli1": "node scripts/bb-proof-hex.mjs circuits/yohualli_one_attest_sig/target/proof/proof",
    "circuit:public-inputs:yohualli1": "node scripts/bb-public-inputs-hex-lines.mjs circuits/yohualli_one_attest_sig/target/proof/public_inputs",
    "circuit:prover:yohualli-merkle-v1": "node scripts/gen-yohualli-merkle-attest-v1-prover.mjs",
    "circuit:proof-hex:yohualli-merkle-v1": "node scripts/bb-proof-hex.mjs circuits/yohualli_merkle_attest_v1/target/proof/proof",
    "circuit:public-inputs:yohualli-merkle-v1": "node scripts/bb-public-inputs-hex-lines.mjs circuits/yohualli_merkle_attest_v1/target/proof/public_inputs",
    "verifier:sync:honk:merkle-v1": "bash scripts/sync-honk-verifier-merkle-v1.sh",
    "circuit:copy-artifact:merkle-v1": "cp circuits/yohualli_merkle_attest_v1/target/yohualli_merkle_attest_v1.json src/circuits/artifacts/yohualli_merkle_attest_v1.json",
    "circuit:copy-artifact:subject-commitment-v0": "cp circuits/yohualli_subject_commitment_v0/target/yohualli_subject_commitment_v0.json src/circuits/artifacts/yohualli_subject_commitment_v0.json",
    "evm:forge:merkle": "cd evm/yohualli_honk_verifier && forge build && forge script script/DeployYohualliMerkleHonkRegistry.s.sol:DeployYohualliMerkleHonkRegistry --rpc-url $RPC_URL --broadcast -g 500",
    "evm:forge:merkle:set-honk": "cd evm/yohualli_honk_verifier && forge build && forge script script/SetYohualliMerkleRegistryHonk.s.sol:SetYohualliMerkleRegistryHonk --rpc-url $RPC_URL --broadcast -g 500",
    "evm:forge:merkle:replace-honk": "cd evm/yohualli_honk_verifier && forge build && forge script script/ReplaceYohualliMerkleRegistryHonk.s.sol:ReplaceYohualliMerkleRegistryHonk --rpc-url $RPC_URL --broadcast -g 500",
    "evm:forge:merkle:set-root": "bash scripts/forge-merkle-set-root.sh",
    "evm:forge:probe:create": "cd evm/yohualli_honk_verifier && forge build && forge script script/DeployHubCreateProbe.s.sol:DeployHubCreateProbe --rpc-url $RPC_URL --broadcast -g 500",
    "evm:forge:honk": "cd evm/yohualli_honk_verifier && forge build && forge script script/DeployHonkVerifier.s.sol:DeployHonkVerifier --rpc-url $RPC_URL --broadcast -g 500",
    "lab:derive-evm-roles": "node scripts/yohualli-derive-evm-lab-roles.mjs",
    "pvm:compile": "cd evm/polkadot_pvm && yarn install && yarn hardhat compile",
    "pvm:deploy:probe": "cd evm/polkadot_pvm && yarn install && yarn run deploy:probe",
    "debug:bb-wasm-subject": "node scripts/debug-bb-wasm-prove-subject.mjs",
    "merkle:root:trusted-seed-leaves": "node scripts/merkle-root-for-trusted-seed-leaves.mjs",
    "merkle:prover-toml:merkle-v1": "node scripts/gen-yohualli-merkle-attest-v1-prover.mjs",
    "yoh:toolbox": "node scripts/yohualli-toolbox.mjs"
  },
  "dependencies": {
    "@aztec/bb.js": "5.0.0-nightly.20260422",
    "@hookform/resolvers": "^5.2.2",
    "@noir-lang/noir_js": "1.0.0-beta.20",
