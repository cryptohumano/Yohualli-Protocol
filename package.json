    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "util": "^0.12.5",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2",
    "viem": "^2.21.0",
    "vite-plugin-node-polyfills": "0.17.0",
    "zod": "^4.2.1"
