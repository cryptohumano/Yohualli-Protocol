  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/events": "^3",
    "@types/node": "^22.10.2",
    "@types/prop-types": "^15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-is": "^19",
    "@types/uuid": "^11.0.0",
